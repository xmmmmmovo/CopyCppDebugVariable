{
  "name": "copy-cpp-debug-variable",
  "displayName": "Copy Cpp Debug Variable",
  "description": "Copy cpp variable recursively in JSON",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/xmmmmmovo/CopyCppDebugVariableExtension.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onDebug"
  ],
  "contributes": {
    "commands": [
      {
        "command": "copy-cpp-debug-variable.copyAsJson",
        "title": "Copy Debug Variable as JSON"
      },
      {
        "command": "copy-cpp-debug-variable.saveAsJson",
        "title": "Save Debug Variable as JSON"
      },
      {
        "command": "copy-cpp-debug-variable.copySelectedAsJson",
        "title": "Copy as JSON"
      },
      {
        "command": "copy-cpp-debug-variable.saveSelectedAsJson",
        "title": "Save as JSON"
      }
    ],
    "menus": {
      "debug/variables/context": [
        {
          "command": "copy-cpp-debug-variable.copySelectedAsJson",
          "when": "debugState == 'stopped'",
          "group": "5_cutcopypaste@100"
        },
        {
          "command": "copy-cpp-debug-variable.saveSelectedAsJson",
          "when": "debugState == 'stopped'",
          "group": "5_cutcopypaste@101"
        }
      ],
      "debug/watch/context": [
        {
          "command": "copy-cpp-debug-variable.copySelectedAsJson",
          "when": "debugState == 'stopped'",
          "group": "5_cutcopypaste@100"
        },
        {
          "command": "copy-cpp-debug-variable.saveSelectedAsJson",
          "when": "debugState == 'stopped'",
          "group": "5_cutcopypaste@101"
        }
      ],
      "commandPalette": [
        {
          "command": "copy-cpp-debug-variable.copySelectedAsJson",
          "when": "false"
        },
        {
          "command": "copy-cpp-debug-variable.saveSelectedAsJson",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Copy Cpp Debug Variable",
      "properties": {
        "copy-cpp-debug-variable.maxDepth": {
          "type": "number",
          "default": 8,
          "minimum": 1
        },
        "copy-cpp-debug-variable.maxVariables": {
          "type": "number",
          "default": 10000,
          "minimum": 1
        },
        "copy-cpp-debug-variable.maxArrayItems": {
          "type": "number",
          "default": 1000,
          "minimum": 1
        },
        "copy-cpp-debug-variable.variablePagingSize": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "maximum": 1000
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "pnpm": {
    "overrides": {
      "diff": "^8.0.4",
      "serialize-javascript": "^7.0.6"
    }
  }
}